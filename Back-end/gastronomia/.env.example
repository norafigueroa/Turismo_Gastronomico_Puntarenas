# Copia este archivo a ".env" (solo desarrollo local). ".env" está en .gitignore.
# En producción (Railway) estas variables se cargan en el panel del servicio, no en un archivo.
# Generar una clave: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de datos (en Railway se rellenan solas con las variables MYSQL* del plugin de MySQL)
DB_NAME=gastronomia
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Solo producción, opcionales (separadas por comas, con https://):
# CORS_ALLOWED_ORIGINS=https://tu-app.vercel.app
# CSRF_TRUSTED_ORIGINS=https://tu-app.vercel.app
